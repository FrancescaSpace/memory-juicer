# 复制本文件为 .env 后填写。.env 不要提交到版本库。

# 阿里云百炼（DashScope）API Key。留空则进入「离线演示模式」：
# 语音不转写、润色不调用大模型，但整条产品链路仍可完整走通。
DASHSCOPE_BASE="your_base_url"
DASHSCOPE_API_KEY="your_api_key"

# 文本润色 / 追问生成的模型
LLM_MODEL=qwen-plus
# 语音转写模型
ASR_MODEL=paraformer-realtime-v2

# 服务自身地址，导出 PDF 时无头浏览器需要访问它
APP_BASE_URL=http://127.0.0.1:8000